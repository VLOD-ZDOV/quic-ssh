# System-wide qshd: runs as root, every user logs in as themselves with their own keys.
# Install: sudo cp contrib/qshd.service /etc/systemd/system/ && sudo systemctl enable --now qshd
[Unit]
Description=qsh server (secure shell over QUIC)
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/usr/local/bin/qshd -t
ExecStart=/usr/local/bin/qshd serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
